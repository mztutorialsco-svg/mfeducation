# Cashfree Payment Gateway Credentials
# ⚠️  NEVER commit this file to git — it is already in .gitignore
# Add these as Environment Variables in your Vercel project dashboard

# Cashfree API Credentials (from https://merchant.cashfree.com → API Keys)
CASHFREE_APP_ID=your_app_id_here
CASHFREE_SECRET_KEY=your_secret_key_here

# Environment: 'sandbox' for testing, 'production' for live payments
CASHFREE_ENV=production

# Your website URL (used for Cashfree return_url)
SITE_URL=https://mfeducation.in

# (Optional) Cashfree Webhook URL for server-to-server payment notifications
CASHFREE_WEBHOOK_URL=

# (Optional) Restrict CORS to your domain only
ALLOWED_ORIGIN=https://mfeducation.in
